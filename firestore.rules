rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    function isAdmin() {

      return request.auth != null

        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;

    }


    /* =========================
       ADMINS
    ========================= */

    match /admins/{userId} {

      allow read:
        if request.auth != null
        && request.auth.uid == userId;

      allow write:
        if false;

    }


    /* =========================
       PORTFOLIO WORK
    ========================= */

    match /portfolioItems/{itemId} {

      allow read:
        if isAdmin()
        || resource.data.published == true;

      allow create:
        if isAdmin();

      allow update, delete:
        if isAdmin();

    }


    /* =========================
       EXPERIENCE
    ========================= */

    match /experiences/{experienceId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();

    }


    /* =========================
       EDUCATION
    ========================= */

    match /education/{educationId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();

    }


    /* =========================
       SKILLS
    ========================= */

    match /skills/{skillId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();

    }


    /* =========================
       CATEGORIES
    ========================= */

    match /categories/{categoryId} {

      allow read, write:
        if isAdmin();

    }


    /* =========================
       CLIENTS
    ========================= */

    match /clients/{clientId} {

      allow read, write:
        if isAdmin();

    }


    /* =========================
       PROFILE
    ========================= */

    match /siteSettings/profile {

      allow read:
        if true;

      allow write:
        if isAdmin();

    }


    /* =========================
       SITE CONTENT
    ========================= */

    match /siteSettings/content {

      allow read:
        if true;

      allow write:
        if isAdmin();

    }

  }

}
